# Local
NEXT_PUBLIC_APP_URL=http://localhost:43123

# Vercel: deixe NEXT_PUBLIC_APP_URL vazio no primeiro deploy.
# O app usa automaticamente https://SEU-PROJETO.vercel.app
# (VERCEL_PROJECT_PRODUCTION_URL). Depois do primeiro deploy, cole a URL
# estável aqui se quiser fixar metadata, sitemap e webhooks.

# Produção mínima — sem isso o cadastro fica só no navegador
# Dashboard → Project Settings → API. Nunca use a service role no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Depois — Asaas (mensalidades Pix dinâmico dos alunos)
# Conta em https://sandbox.asaas.com · Integrações → API Key
# Webhook: POST {URL_DA_VERCEL}/api/asaas/webhook
# Header asaas-access-token = ASAAS_WEBHOOK_TOKEN
# Eventos: PAYMENT_RECEIVED, PAYMENT_CONFIRMED
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Depois — Stripe (plano do JiuPro, não a mensalidade do aluno)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_ACADEMIA=
STRIPE_PRICE_EQUIPE=
