NEXT_PUBLIC_APP_URL=http://localhost:43123

# Supabase — URL + anon public. Sem isso o cadastro fica só neste navegador.
# Também dá para colar as duas em Configurações (não precisa de .env).
# Nunca use a service role no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (sandbox por enquanto — mensalidades dos alunos)
# Conta em https://sandbox.asaas.com · Integrações → API Key
# Webhook: POST {APP_URL}/api/asaas/webhook
# Header asaas-access-token = ASAAS_WEBHOOK_TOKEN
# Eventos: PAYMENT_RECEIVED, PAYMENT_CONFIRMED
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Stripe (opcional — plano do JiuPro, não a mensalidade do aluno)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_ACADEMIA=
STRIPE_PRICE_EQUIPE=
