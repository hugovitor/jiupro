# Local
NEXT_PUBLIC_APP_URL=http://localhost:43123

# Produção (Vercel):
# NEXT_PUBLIC_APP_URL=https://tatamex.vercel.app
# Settings → General → Project Name = tatamex (gera tatamex.vercel.app)

# Produção mínima — sem isso o cadastro fica só no navegador
# Dashboard → Project Settings → API. Nunca use a service role no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Operador: URI do Postgres (Direct ou pooler). Com isso o app do aluno aplica o SQL do convite sozinho.
# Sem isso, rode o trecho uma vez no SQL Editor — o dono da academia nunca vê SQL.
DATABASE_URL=

# Depois — Asaas (mensalidades Pix dinâmico dos alunos)
# Conta em https://sandbox.asaas.com · Integrações → API Key
# Webhook: POST https://tatamex.vercel.app/api/asaas/webhook
# Header asaas-access-token = ASAAS_WEBHOOK_TOKEN
# Eventos: PAYMENT_RECEIVED, PAYMENT_CONFIRMED
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Depois — Stripe (plano do TatameX, não a mensalidade do aluno)
# Webhook: https://tatamex.vercel.app/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_ACADEMIA=
STRIPE_PRICE_EQUIPE=
# Cadastro novo: 30 = um mês grátis. 0 desliga. Cupom digitado no cadastro substitui o trial.
NEXT_PUBLIC_STRIPE_TRIAL_DAYS=30
# Opcional: aplica sozinho em todo cadastro se o cliente não digitar código
STRIPE_SIGNUP_PROMO=
# E-mails com acesso ao painel /operacao (além do dono do TatameX)
JIUPRO_OPERATOR_EMAILS=
TATAMEX_OPERATOR_EMAILS=

# Opcional — deixa o assistente redigir a resposta (sem isso ele já responde pela base do TatameX)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

