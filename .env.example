NEXT_PUBLIC_APP_URL=http://localhost:43123

# Supabase — URL + anon public. Sem isso o cadastro fica só neste navegador.
# Também dá para colar as duas em Configurações (não precisa de .env).
# Nunca use a service role no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (opcional — sem isso o plano muda só na demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_ACADEMIA=
STRIPE_PRICE_EQUIPE=
